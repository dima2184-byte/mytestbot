[Unit]
Description=Git Relay cmd_runner
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/mytestbot
ExecStart=/root/mytestbot/venv/bin/python3 /root/mytestbot/cmd_runner.py
Restart=always
RestartSec=10
EnvironmentFile=-/root/mytestbot/.env

[Install]
WantedBy=multi-user.target
